# Leave empty for local Vite proxy requests (/api -> FastAPI on port 8000).
# Set an HTTPS URL for a release build, e.g. https://api.example.com
VITE_API_BASE_URL=

# Optional Firebase Web config (public client identifiers, not server secrets).
# Populate these after creating a Firebase project; enable Anonymous + Email/Password auth.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MESSAGING_SENDER_ID=
