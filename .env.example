# FastAPI backend. Copy to .env or export variables before starting the server.
APP_ENV=development
# `dev` uses a non-secure device ID for local testing only. Production must use Firebase.
AUTH_MODE=dev
APP_ALLOWED_ORIGINS=capacitor://localhost,http://localhost,https://localhost
USAGE_DATABASE=server/.data/usage.sqlite3
FREE_DAILY_LIMIT=30
PRO_DAILY_LIMIT=300

# Free routes. Keep keys on the server; never put them in the mobile app.
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_BASE_URL=https://api.groq.com/openai/v1
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
FREE_PROVIDER_ORDER=groq,gemini

# Optional paid route: configure only the documented OpenAI-compatible endpoint
# and model supplied by your paid provider. No Arena endpoint is assumed here.
PREMIUM_API_BASE_URL=
PREMIUM_API_KEY=
PREMIUM_MODEL=

# Production Firebase Admin verification (use Application Default Credentials or a
# service-account file mounted outside the repository; never commit that file).
FIREBASE_PROJECT_ID=
FIREBASE_CREDENTIALS_FILE=

# Agent-mode PDF limits
MAX_PDF_BYTES=8388608
MAX_PDF_PAGES=40
MAX_DOCUMENT_CHARS=40000
